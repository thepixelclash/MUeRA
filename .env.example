# Placeholders only. Never commit real values.
# Public (browser) - safe to expose, anon/publishable key only:
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server-side (same values; used to verify sign-in tokens on the AI endpoint):
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# AI provider, server-side secrets (any OpenAI-compatible API). Set as host secrets, never VITE_*:
AI_BASE_URL=https://YOUR_PROVIDER/v1
AI_API_KEY=YOUR_PROVIDER_KEY
AI_MODEL=YOUR_MODEL_NAME
# Optional limits per user:
AI_RATE_PER_MINUTE=12
AI_RATE_PER_DAY=200

# Static/InfinityFree build only
VITE_AI_ENDPOINT=/api/ai.php
# Optional: public Google OAuth client ID for saving uploads to each user's own Drive (drive.file). Leave unset to keep the feature hidden.
VITE_GOOGLE_CLIENT_ID=
